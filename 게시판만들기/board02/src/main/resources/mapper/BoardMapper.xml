<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.board02.mapper.BoardMapper">

    <!-- 게시글 목록 조회 -->
    <select id="selectBoardList" resultType="com.example.board02.domain.Board">
        SELECT * FROM board 
        ORDER BY id DESC
    </select>

    <!-- 게시글 상세 조회 -->
    <select id="selectBoardById" parameterType="Long" resultType="com.example.board02.domain.Board">
        SELECT * FROM board 
        WHERE id = #{id}
    </select>

    <!-- 게시글 저장 -->
    <insert id="insertBoard" parameterType="com.example.board02.domain.Board">
        INSERT INTO board (title, content, writer) 
        VALUES (#{title}, #{content}, #{writer})
    </insert>

    <!-- 게시글 수정 -->
    <update id="updateBoard" parameterType="com.example.board02.domain.Board">
        UPDATE board 
        SET title = #{title}, 
            content = #{content},
            modified_date = NOW() 
        WHERE id = #{id}
    </update>

    <!-- 게시글 삭제 -->
    <delete id="deleteBoard" parameterType="Long">
        DELETE FROM board 
        WHERE id = #{id}
    </delete>

    <!-- 조회수 증가 -->
    <update id="updateViewCount" parameterType="Long">
        UPDATE board 
        SET view_count = view_count + 1 
        WHERE id = #{id}
    </update>
</mapper>